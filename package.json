{
  "name": "xinghen",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "星痕：在 Linux 本机运行的个人日记与生活空间",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "node --watch server/main.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/main.ts",
    "check": "tsc -p web/tsconfig.json && tsc -p server/tsconfig.json",
    "test": "node --test server/test/*.test.ts"
  },
