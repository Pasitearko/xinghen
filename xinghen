#!/usr/bin/env bash
# 星痕启动器（Linux）。不带参数运行 = 确保服务在跑，然后打开浏览器。
set -euo pipefail

CALLER_PWD="$PWD"
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/xinghen"
CONF="$CONF_DIR/env"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/xinghen"
LOG="$STATE/xinghen.log"
PIDFILE="$STATE/xinghen.pid"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT="$UNIT_DIR/xinghen.service"
DESKTOP="${XDG_DATA_HOME:-$HOME/.local/share}/applications/xinghen.desktop"

# 改名前（feixing）的配置、日志、自启服务和菜单图标所在位置，只用来把它们迁到新名字下
LEGACY_CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/feixing"
LEGACY_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/feixing"
LEGACY_UNIT="$UNIT_DIR/feixing.service"
LEGACY_DESKTOP="${XDG_DATA_HOME:-$HOME/.local/share}/applications/feixing.desktop"

# 配置和日志必须在读配置之前搬好；变量名、旧数据路径一并改成新的
migrate_legacy_files() {
  if [[ -d "$LEGACY_CONF_DIR" && ! -e "$CONF_DIR" ]]; then
    mv "$LEGACY_CONF_DIR" "$CONF_DIR"
    if [[ -f "$CONF" ]]; then sed -i -e 's/FEIXING_/XINGHEN_/g' -e 's#/\.local/share/feixing#/.local/share/xinghen#g' -e 's#\./feixing#./xinghen#g' -e 's/飞星/星痕/g' "$CONF"; fi
  fi
  if [[ -d "$LEGACY_STATE" && ! -e "$STATE" ]]; then
    mv "$LEGACY_STATE" "$STATE"
    for f in "$STATE"/feixing.*; do
      if [[ -e "$f" ]]; then mv "$f" "$STATE/xinghen.${f##*/feixing.}"; fi
    done
  fi
  return 0
}
migrate_legacy_files

# 用户配置（端口、音乐目录、代理等），格式是 KEY=VALUE，systemd 服务也读同一份
if [[ -f "$CONF" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$CONF"
  set +a
fi
PORT="${XINGHEN_PORT:-8001}"
URL="http://127.0.0.1:$PORT"

# 有代理就让 Node 的 fetch 走代理（抓资讯用）
if [[ -n "${https_proxy:-}${HTTPS_PROXY:-}${http_proxy:-}${HTTP_PROXY:-}${all_proxy:-}${ALL_PROXY:-}" ]]; then
  export NODE_USE_ENV_PROXY=1
fi

say() { printf '\033[38;5;222m星痕\033[0m %s\n' "$*"; }
die() { printf '\033[38;5;174m星痕\033[0m %s\n' "$*" >&2; exit 1; }

need_node() {
  command -v node >/dev/null 2>&1 || die "没找到 Node.js。请先安装 Node 23.6 或更新的版本（例如 sudo pacman -S nodejs / sudo apt install nodejs）。"
  local v major minor
  v="$(node -p 'process.versions.node')"
  major="${v%%.*}"
  minor="${v#*.}"
  minor="${minor%%.*}"
  if (( major < 23 || (major == 23 && minor < 6) )); then
    die "Node 版本是 $v，星痕需要 23.6 以上（直接运行 TypeScript 和内置 SQLite）。"
  fi
}

need_deps() {
  cd "$ROOT"
  if command -v pnpm >/dev/null 2>&1; then
    if [[ ! -f node_modules/.modules.yaml || pnpm-lock.yaml -nt node_modules/.modules.yaml ]]; then
      say "安装依赖（只有第一次或更新后需要）…"
      pnpm install --frozen-lockfile --reporter=silent || pnpm install
    fi
  elif [[ ! -d node_modules ]]; then
    command -v npm >/dev/null 2>&1 || die "没找到 pnpm 或 npm。"
    say "安装依赖（只有第一次需要）…"
    npm install --no-fund --no-audit
  fi
}

# 网页源码比构建产物新时才重新构建
need_build() {
  cd "$ROOT"
  local stamp="web/dist/index.html"
  if [[ ! -f "$stamp" ]] || [[ -n "$(find web/src web/public web/index.html web/vite.config.ts package.json -newer "$stamp" -print -quit 2>/dev/null)" ]]; then
    build
  fi
}

build() {
  cd "$ROOT"
  say "构建网页…"
  ./node_modules/.bin/vite build --config web/vite.config.ts --logLevel warn
}

healthy() {
  local body
  if command -v curl >/dev/null 2>&1; then
    body="$(curl -fsS --max-time 1 "$URL/api/health" 2>/dev/null)" || return 1
  else
    body="$(node -e "fetch('$URL/api/health',{signal:AbortSignal.timeout(1000)}).then(r=>r.text()).then(console.log,()=>process.exit(1))" 2>/dev/null)" || return 1
  fi
  [[ "$body" == *'"app":"xinghen"'* ]]
}

has_service() { [[ -f "$UNIT" ]] && command -v systemctl >/dev/null 2>&1; }

start() {
  if healthy; then
    say "已经在运行：$URL"
    return 0
  fi
  need_node
  need_deps
  need_build
  if has_service; then
    systemctl --user start xinghen.service
  else
    mkdir -p "$STATE"
    # 日志超过 5MB 就轮换一次
    if [[ -f "$LOG" ]] && (( $(stat -c %s "$LOG") > 5242880 )); then mv -f "$LOG" "$LOG.1"; fi
    cd "$ROOT"
    setsid nohup node server/main.ts >>"$LOG" 2>&1 < /dev/null &
    echo $! > "$PIDFILE"
  fi
  for _ in $(seq 1 50); do
    if healthy; then
      say "已启动：$URL"
      return 0
    fi
    sleep 0.2
  done
  tail -n 20 "$LOG" 2>/dev/null || true
  die "没能启动。完整日志：$LOG"
}

stop() {
  if has_service && systemctl --user is-active --quiet xinghen.service; then
    systemctl --user stop xinghen.service
    say "已停止"
    return 0
  fi
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    kill "$(cat "$PIDFILE")"
    rm -f "$PIDFILE"
    say "已停止"
  elif healthy; then
    die "星痕在运行，但不是这个启动器开的（看看是不是在别的终端里）。"
  else
    say "本来就没在运行"
  fi
}

status() {
  if healthy; then
    say "运行中：$URL"
    command -v curl >/dev/null 2>&1 && curl -fsS "$URL/api/backup" 2>/dev/null | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{const j=JSON.parse(s);console.log('  数据目录 '+j.data_dir+'\n  音乐目录 '+j.music_dir+'\n  备份目录 '+j.dir)}catch{}})" || true
  else
    say "没在运行"
    return 1
  fi
}

open_browser() {
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$URL" >/dev/null 2>&1 &
  else
    say "在浏览器里打开 $URL"
  fi
}

install_service() {
  need_node
  need_deps
  need_build
  local node_bin
  node_bin="$(command -v node)"
  mkdir -p "$UNIT_DIR" "$CONF_DIR" "$(dirname "$DESKTOP")"
  if [[ ! -f "$CONF" ]]; then
    cat > "$CONF" <<'EOF'
# 星痕的配置，改完运行 ./xinghen restart 生效。去掉行首的 # 即启用。
# XINGHEN_PORT=8001
# XINGHEN_MUSIC_DIR=/home/你/Music
# XINGHEN_DATA_DIR=/home/你/.local/share/xinghen
# XINGHEN_TZ=Asia/Shanghai
# 抓资讯需要代理的话：
# HTTPS_PROXY=http://127.0.0.1:7890
# NODE_USE_ENV_PROXY=1
EOF
  fi
  cat > "$UNIT" <<EOF
[Unit]
Description=星痕 本机日记
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$ROOT
EnvironmentFile=-$CONF
ExecStart=$node_bin $ROOT/server/main.ts
Restart=on-failure
RestartSec=3
# 退出码 3 = 端口被占用，重启也没用
RestartPreventExitStatus=3

[Install]
WantedBy=default.target
EOF
  cat > "$DESKTOP" <<EOF
[Desktop Entry]
Type=Application
Name=星痕
Comment=本机日记与生活空间
Exec="$ROOT/xinghen" open
Icon=$ROOT/web/public/favicon.svg
Terminal=false
Categories=Office;Utility;
Keywords=diary;journal;日记;
EOF
  # 先停掉手动开的进程，交给 systemd 管
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then kill "$(cat "$PIDFILE")"; rm -f "$PIDFILE"; sleep 0.5; fi
  systemctl --user daemon-reload
  systemctl --user enable --now xinghen.service
  say "已设为开机（登录后）自动启动，应用菜单里也有「星痕」了。"
  say "配置文件：$CONF"
  say "查看日志：journalctl --user -u xinghen -f"
}

uninstall_service() {
  if [[ -f "$UNIT" ]]; then
    systemctl --user disable --now xinghen.service 2>/dev/null || true
    rm -f "$UNIT"
    systemctl --user daemon-reload
  fi
  rm -f "$DESKTOP"
  say "已取消开机自启。数据都还在，没有删除。"
}

logs() {
  if has_service; then
    journalctl --user -u xinghen -n 100 -f
  else
    tail -n 100 -f "$LOG"
  fi
}

usage() {
  cat <<EOF
星痕 · 本机日记

  ./xinghen                 启动（如果还没启动）并打开浏览器
  ./xinghen start           只在后台启动
  ./xinghen stop            停止
  ./xinghen restart         重启（更新代码后用）
  ./xinghen status          看看是否在运行、数据放在哪
  ./xinghen logs            查看日志
  ./xinghen build           重新构建网页
  ./xinghen import <路径>   导入旧数据：旧版数据文件夹 / 备份 zip / JSON；加 --dry 只预览
  ./xinghen install         登录后自动启动 + 加到应用菜单（systemd 用户服务）
  ./xinghen uninstall       取消自动启动
  ./xinghen dev             开发模式（Vite 热更新，端口 5199）

地址 $URL
EOF
}

# 旧名字的自启服务还在：先停掉、删掉（端口才会空出来），之后换成新名字的服务重新装上
migrate_legacy_service() {
  [[ -f "$LEGACY_UNIT" ]] || return 0
  command -v systemctl >/dev/null 2>&1 && systemctl --user disable --now feixing.service 2>/dev/null || true
  rm -f "$LEGACY_UNIT" "$LEGACY_DESKTOP"
  command -v systemctl >/dev/null 2>&1 && systemctl --user daemon-reload || true
  say "已移除旧名字（feixing）的自启服务，改用 xinghen.service"
  install_service
}

cmd="${1:-open}"
shift || true
case "$cmd" in help | -h | --help | uninstall) ;; *) migrate_legacy_service ;; esac
case "$cmd" in
  open) start && open_browser ;;
  start) start ;;
  stop) stop ;;
  restart)
    if has_service; then need_build; systemctl --user restart xinghen.service; sleep 0.5; start; else stop; start; fi ;;
  status) status ;;
  logs | log) logs ;;
  build) need_node; need_deps; build ;;
  import)
    need_node
    need_deps
    [[ $# -ge 1 ]] || die "用法：./xinghen import <路径> [--dry]"
    cd "$ROOT"
    # 相对路径按调用时的目录解析
    target="$1"; shift
    [[ "$target" = /* ]] || target="$CALLER_PWD/$target"
    node scripts/import.ts "$target" "$@" ;;
  install) install_service ;;
  uninstall) uninstall_service ;;
  dev) need_node; need_deps; cd "$ROOT"; exec node scripts/dev.ts ;;
  help | -h | --help) usage ;;
  *) usage; exit 2 ;;
esac
